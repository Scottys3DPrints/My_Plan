<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up, and nothing transfers to a new device.

  This is a deliberate anti-circumvention decision as much as a privacy one: if the rule
  set could be restored from a backup, "restore an older backup" would be a one-tap way
  around a cooling-off period.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
